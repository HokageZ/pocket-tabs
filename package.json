{
  "name": "pocket-tabs",
  "displayName": "Pocket Tabs",
  "description": "See the tabs open in every VS Code window on this PC and edit them from your phone over the local network.",
  "version": "1.1.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HokageZ/pocket-tabs.git"
  },
  "homepage": "https://github.com/HokageZ/pocket-tabs#readme",
  "bugs": {
    "url": "https://github.com/HokageZ/pocket-tabs/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "phone",
    "mobile",
    "remote",
    "tabs",
    "lan"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pocketTabs.showQr",
        "title": "Show Phone QR Code",
        "category": "Pocket Tabs",
        "icon": "$(device-mobile)"
      },
      {
        "command": "pocketTabs.copyUrl",
        "title": "Copy Phone Link",
        "category": "Pocket Tabs"
      },
      {
        "command": "pocketTabs.regenerateToken",
        "title": "New Access Code (signs out phones)",
        "category": "Pocket Tabs"
      },
      {
        "command": "pocketTabs.showLog",
        "title": "Show Log",
        "category": "Pocket Tabs"
      }
    ],
    "configuration": {
      "title": "Pocket Tabs",
      "properties": {
        "pocketTabs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run Pocket Tabs in this VS Code window."
        },
        "pocketTabs.port": {
          "type": "number",
          "default": 8787,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Network port your phone connects to. All VS Code windows that use the same port show up on the same phone page."
        },
        "pocketTabs.bindAddress": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Network address to listen on. 0.0.0.0 means every network on this PC. Use 127.0.0.1 to turn off phone access."
        },
        "pocketTabs.highlightPhoneEdits": {
          "type": "boolean",
          "default": true,
          "description": "Mark lines edited from a phone with a violet bar (hover to see which phone and when), and show where a phone is editing."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "vscode:prepublish": "node build.mjs",
    "test": "node test/sync.test.js && node test/collab.test.mjs && node test/paths.test.js",
    "package": "npx --yes @vscode/vsce@3 package --no-dependencies"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "esbuild": "^0.28.2",
    "qrcode-generator": "1.4.4"
  }
}
